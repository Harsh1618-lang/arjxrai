# ---- Supabase (OPTIONAL) ----
# If you set these, the app uses real Supabase backend (production).
# If you leave them empty, the app runs in demo mode (local browser storage).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: canonical site URL used for SEO defaults
VITE_SITE_URL=https://your-domain.com
