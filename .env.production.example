# ---- Frontend (Vite) ----
# Supabase project credentials. Set these in Vercel → Project → Settings → Env Vars.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Canonical production URL (used for SEO defaults)
VITE_SITE_URL=https://your-domain.com

# ---- Supabase Edge Function secrets (set in Supabase → Settings → Edge Functions) ----
# Used by supabase/functions/contact to email the owner (optional)
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_EMAIL=owner@yourdomain.com

# Google OAuth (set in Supabase → Authentication → Providers)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
